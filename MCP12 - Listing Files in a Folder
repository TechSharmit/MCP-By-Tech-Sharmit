import os
from mcp.server.fastmcp import FastMCP

mcp = FastMCP("FileListServer")

# This tool lists all files present in a given folder.
# os.listdir() is a Python function that returns a list of
# file/folder names inside the given path.

@mcp.tool()

def list_files(folder_path: str = ".") -> str:
    """Lists all files in the given folder. Defaults to the current folder (".")."""
    try:
        files = os.listdir(folder_path)
        if not files:
            return f"No files found in '{folder_path}'."
        return "\n".join(files)
    except FileNotFoundError:
        return f"Error: Folder '{folder_path}' was not found."

if __name__ == "__main__":
    mcp.run()

