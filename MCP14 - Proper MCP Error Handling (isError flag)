from mcp.server.fastmcp import FastMCP
from mcp.server.fastmcp.exceptions import ToolError

mcp = FastMCP("ProperErrorServer")

# ---- Method 1: Raising ToolError ----
# When we RAISE this special error, MCP automatically marks
# the result as isError=True on the protocol level.
# This is DIFFERENT from just returning a string - the client
# can now check result.isError to know for sure it failed.

@mcp.tool()

def divide(a: float, b: float) -> str:
    """Divides a by b. Raises a proper MCP error if b is zero."""
    if b == 0:
        # This is the CORRECT way to signal an error in MCP
        raise ToolError("Cannot divide by zero.")
    return f"Result: {a / b}"

# ---- Method 2: Another example, for comparison ----
@mcp.tool()
def square_root(number: float) -> str:
    """Returns the square root of a number. Raises an error for negative numbers."""
    if number < 0:
        raise ToolError("Cannot calculate square root of a negative number.")
    return f"Result: {number ** 0.5}"

if __name__ == "__main__":
    mcp.run()


