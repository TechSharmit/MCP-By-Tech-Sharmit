from mcp.server.fastmcp import FastMCP

mcp = FastMCP("TemplateDemoServer")

@mcp.resource("info://about")
def get_about_info() -> str:
    """Returns basic information about this server."""
    return "This server demonstrates static vs dynamic resources."

@mcp.resource("profile://{username}")
def get_profile(username: str) -> str:
    """Returns a fake profile summary for the given username."""
    return f"Profile for '{username}': Status = Active, Role = Learner"

@mcp.resource("order://{order_id}")
def get_order(order_id: str) -> str:
    """Returns fake order details for the given order id."""
    return f"Order #{order_id}: Status = Shipped"

if __name__ == "__main__":
    mcp.run()
