# Import FastMCP - this is the tool that helps us build an MCP server easily
from mcp.server.fastmcp import FastMCP

# Create a server and give it a name
mcp = FastMCP("MathServer")

# This tool now takes INPUT (a and b) instead of taking nothing
# "a: int" and "b: int" mean both inputs must be whole numbers
@mcp.tool()
def add(a: int, b: int) -> int:
    """Adds two numbers and returns the result."""
    # This is the actual calculation the tool performs
    return a + b

# Run the server, but only when this file is run directly
if __name__ == "__main__":
    mcp.run()

