from mcp.server.fastmcp import FastMCP

mcp = FastMCP("FileAppendServer")

# This tool ADDS content to the end of a file, without deleting
# what was already there. "a" mode = append mode.
@mcp.tool()
def append_file(filename: str, content: str) -> str:
    """Appends content to the end of a file, keeping existing content intact."""
    try:
        with open(filename, "a") as f:
            f.write(content + "\n")
        return f"Successfully appended to '{filename}'."
    except Exception as e:
        return f"Error appending to file: {str(e)}"

if __name__ == "__main__":
    mcp.run()

