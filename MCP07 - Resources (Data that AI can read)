from mcp.server.fastmcp import FastMCP

mcp = FastMCP("ResourceServer")

# ---- Resource 1: A FIXED resource (no variables in the URL) ----
# This always returns the same content, like a static page
@mcp.resource("info://about")
def get_about_info() -> str:
    """Returns basic information about this server."""
    return "This is a demo MCP server created for learning purposes."

# ---- Resource 2: A DYNAMIC resource (uses a variable in the URL) ----
# The {username} part is a placeholder - it changes based on what is requested
@mcp.resource("profile://{username}")
def get_profile(username: str) -> str:
    """Returns a fake profile summary for the given username."""
    return f"Profile for '{username}': Status = Active, Role = Learner"

# We can still have a normal tool alongside resources in the same server
@mcp.tool()
def add(a: int, b: int) -> int:
    """Adds two numbers and returns the result."""
    return a + b

if __name__ == "__main__":
    mcp.run()

