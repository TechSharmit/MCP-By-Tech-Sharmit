import asyncio
from mcp import ClientSession, StdioServerParameters
from mcp.client.stdio import stdio_client


async def main():

    server_params = StdioServerParameters(
        command="python",
        args=["MCP07-server.py"],
    )

    async with stdio_client(server_params) as (read, write):
        async with ClientSession(read, write) as session:

            await session.initialize()
            print("Connection successful!\n")

            # ---- NEW PART: Reading resources (not calling tools) ----

            # Reading the FIXED resource - notice we use read_resource(), not call_tool()
            about_result = await session.read_resource("info://about")
            print("info://about ->", about_result.contents[0].text)

            # Reading the DYNAMIC resource - we plug in a value where {username} was
            profile_result = await session.read_resource("profile://rohan123")
            print("profile://rohan123 ->", profile_result.contents[0].text)

            # We can also list all resources the server has, similar to list_tools()
            resources_response = await session.list_resources()
            print("\nStatic resources available:")
            for res in resources_response.resources:
                print(f" - {res.uri}: {res.name}")

            # A normal tool call still works exactly the same way as before
            add_result = await session.call_tool("add", arguments={"a": 3, "b": 4})
            print("\nadd(3, 4) =", add_result.content[0].text)


if __name__ == "__main__":
    asyncio.run(main())
