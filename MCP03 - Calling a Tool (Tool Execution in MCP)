# Import FastMCP - this is the tool that helps us build an MCP server easily
from mcp.server.fastmcp import FastMCP

# Create a server and give it a name
mcp = FastMCP("MyFirstServer")

# This tells MCP: "the function below is a TOOL that AI can call"
@mcp.tool()
def hello() -> str:
    """This is a description of the tool. AI reads this to understand what the tool does."""
    return "Hello! This message is coming from the MCP server."

# Run the server, but only when this file is run directly
if __name__ == "__main__":
    mcp.run()
