# asyncio lets Python do things "asynchronously"
# (needed because talking to a server takes time, and we don't want the program to freeze while waiting)
import asyncio

# These are the main MCP building blocks we need for a client
from mcp import ClientSession, StdioServerParameters
from mcp.client.stdio import stdio_client


async def main():

    # Tell the client HOW to start the server
    server_params = StdioServerParameters(
        command="python",
        args=["MCP03-server.py"],
    )

    # Start the server and open a communication channel
    async with stdio_client(server_params) as (read, write):

        async with ClientSession(read, write) as session:

            # Handshake step - connect to the server
            await session.initialize()
            print("Connection successful!\n")

            # ---- Actually calling the tool ----

            # This tells the server: "please run the tool named 'hello'"
            result = await session.call_tool("hello", arguments={})

            # The server sends back a response
            print("Tool called successfully!")
            print("Result from server:", result.content[0].text)


if __name__ == "__main__":
    asyncio.run(main())
