from mcp.server.fastmcp import FastMCP

mcp = FastMCP("FileWriteServer")

# This tool writes content to a file.
# "w" mode = write mode - creates the file if it doesn't exist,
# and OVERWRITES it completely if it already exists.
@mcp.tool()
def write_file(filename: str, content: str) -> str:
    """Writes content to a file. Creates the file if it doesn't exist, overwrites if it does."""
    try:
        with open(filename, "w") as f:
            f.write(content)
        return f"Successfully wrote to '{filename}'."
    except Exception as e:
        return f"Error writing file: {str(e)}"

if __name__ == "__main__":
    mcp.run()

